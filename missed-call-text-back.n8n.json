    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'gpt-4o-mini', response_format: { type: 'json_object' }, temperature: 0, messages: [ { role: 'system', content: 'You qualify inbound leads for ' + $json.BUSINESS_NAME + '. Read the customer text and return JSON with keys: service (short string), urgency (one of: urgent, soon, browsing), summary (one sentence), reply (a friendly SMS under 300 characters that answers them and invites them to book). Never invent prices or availability.' }, { role: 'user', content: $json.message } ] }) }}",
        "options": {}
      },
      "id": "7cc324df-2fc4-41e3-8ced-1d808ac4cb87",
      "name": "AI Qualify Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        400
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_OPENAI",
          "name": "OpenAI (Authorization: Bearer sk-...)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Config + Parse SMS').first().json;\nlet q = {};\ntry { q = JSON.parse($json.choices[0].message.content); } catch (e) { q = {}; }\nconst urgency = ['urgent','soon','browsing'].includes(q.urgency) ? q.urgency : 'soon';\nconst reply = (q.reply || `Thanks for your message! You can book a time here:`) + ` Book here: ${cfg.BOOKING_URL}`;\nreturn [{ json: { ...cfg, service: q.service || 'unknown', urgency, summary: q.summary || cfg.message, reply } }];"
      },
      "id": "49157512-2050-42fe-b5ab-50b4128c3e98",
      "name": "Parse AI Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
